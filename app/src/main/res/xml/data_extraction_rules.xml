<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción de datos (Android 12+): mismas exclusiones que backup_rules.xml
   para la copia en la nube y la transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="estudihambres_session_prefs.xml" />
        <exclude domain="sharedpref" path="estudihambres_registered_accounts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="estudihambres_session_prefs.xml" />
        <exclude domain="sharedpref" path="estudihambres_registered_accounts.xml" />
    </device-transfer>
</data-extraction-rules>
