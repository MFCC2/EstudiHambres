<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de Auto Backup (Android 11 o inferior).
   Se excluyen las preferencias con credenciales (hash de contraseña), DNI y la sesión activa:
   restaurarlas en otro teléfono filtraría datos personales (Ley N° 29733) y reabriría una
   sesión que debe autenticarse de nuevo contra Firebase.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="estudihambres_session_prefs.xml" />
    <exclude domain="sharedpref" path="estudihambres_registered_accounts.xml" />
</full-backup-content>
